      "name": "Geocoding",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();\r",
              "\r",
              "if (data.results && data.results.length > 0) {\r",
              "    const location = data.results[0];\r",
              "    pm.collectionVariables.set('lat', location.latitude);\r",
              "    pm.collectionVariables.set('lon', location.longitude);\r",
              "    console.log('Координаты сохранены:', location.latitude, location.longitude);\r",
              "} else {\r",
              "    console.warn('Город не найден, координаты не сохранены');\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
